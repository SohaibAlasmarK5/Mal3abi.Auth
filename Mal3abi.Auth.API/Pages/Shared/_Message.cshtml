@* A message box. Model: (string Kind, string Text) with Kind "danger", "success" or "warning". *@
@model (string Kind, string Text)
@if (!string.IsNullOrWhiteSpace(Model.Text))
{
    <div class="message message-@Model.Kind" role="@(Model.Kind == "danger" ? "alert" : "status")">
        @if (Model.Kind == "success")
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
        }
        else if (Model.Kind == "warning")
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4M12 17h.01"></path></svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
        }
        <span>@Model.Text</span>
    </div>
}
