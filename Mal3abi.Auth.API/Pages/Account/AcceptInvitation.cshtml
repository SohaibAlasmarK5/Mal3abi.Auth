@page "/account/accept-invitation"
@model Mal3abi.Auth.API.Pages.Account.AcceptInvitationModel
@{
    Layout = "_AuthLayout";
    var ui = AuthUi.For(HttpContext.Request);
    ViewData["Title"] = ui.T("invite.title");
}
<h1>@ui.T("invite.title")</h1>
@if (!Model.Succeeded)
{
    <p class="intro">@ui.T("invite.intro")</p>
}
<partial name="_Message" model="@((Model.Succeeded ? "success" : "danger", ui.Server(Model.Message)))" />
@if (Model.Succeeded)
{
    <a class="btn" href="/account/login">@ui.T("invite.signIn")</a>
}
else
{
    <form method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="PasswordToken" />
        <input type="hidden" asp-for="EmailToken" />
        <div class="field">
            <label asp-for="Password">@ui.T("invite.password")</label>
            <input asp-for="Password" type="password" minlength="8" maxlength="128" required autocomplete="new-password" />
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">@ui.T("invite.confirm")</label>
            <input asp-for="ConfirmPassword" type="password" minlength="8" maxlength="128" required autocomplete="new-password" />
        </div>
        <button type="submit" class="btn">@ui.T("invite.submit")</button>
    </form>
}
