@page "/account/accept-invitation"
@model Mal3abi.Auth.API.Pages.Account.AcceptInvitationModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.T("invite.title");
}
<h1>@ui.T("invite.title")</h1>
<p class="intro">@ui.T("invite.intro")</p>
<partial name="_Message" model="@(("danger", Model.ErrorMessage ?? ""))" />
<div asp-validation-summary="All"></div>
<form method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />
    <div class="field">
        <label asp-for="Password">@ui.T("invite.password")</label>
        <input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required aria-describedby="password-hint" />
        <p class="hint" id="password-hint">@ui.T("register.passwordHint")</p>
    </div>
    <div class="field">
        <label asp-for="ConfirmPassword">@ui.T("invite.confirm")</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required />
    </div>
    <button type="submit" class="btn">@ui.T("invite.submit")</button>
</form>
<div class="links">
    <a href="@Url.Page("/Account/Login")">@ui.T("invite.signIn")</a>
</div>
