@page "/account/accept-invitation"
@model Mal3abi.Auth.API.Pages.Account.AcceptInvitationModel
@{ Layout = null; ViewData["Title"] = "تفعيل الدعوة | ملعبي"; }
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"]</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;padding:18px;background:#0b1220;color:#eef2f8;font:1rem "Segoe UI",Tahoma,Arial}main{width:min(100%,460px);padding:28px;border:1px solid #2b3b55;border-radius:16px;background:#172338}p{color:#aebbd0;line-height:1.7}label{display:block;margin:15px 0 6px}input,button{width:100%;min-height:46px;padding:10px;border-radius:8px;font:inherit}input{border:1px solid #33445e;background:#111b2c;color:white}button{margin-top:18px;border:0;background:#00c875;font-weight:700}.error{color:#ff9999}</style></head><body><main><h1>تفعيل حسابك</h1><p>أنشئ كلمة مرور لتفعيل الحساب المرسل إليك.</p>@if(!string.IsNullOrWhiteSpace(Model.Message)){<p class="@(Model.Succeeded ? "" : "error")" role="status">@Model.Message</p>}@if(!Model.Succeeded){<form method="post"><input type="hidden" asp-for="UserId"><input type="hidden" asp-for="PasswordToken"><input type="hidden" asp-for="EmailToken"><label asp-for="Password">كلمة المرور</label><input asp-for="Password" type="password" minlength="8" maxlength="128" required autocomplete="new-password"><label asp-for="ConfirmPassword">تأكيد كلمة المرور</label><input asp-for="ConfirmPassword" type="password" minlength="8" maxlength="128" required autocomplete="new-password"><button type="submit">تفعيل الحساب</button></form>}</main></body></html>
