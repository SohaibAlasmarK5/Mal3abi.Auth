@page "/account/confirm-email"
@model Mal3abi.Auth.API.Pages.Account.ConfirmEmailModel
@{
    Layout = "_AuthLayout";
    var ui = AuthUi.For(HttpContext.Request);
    var heading = string.IsNullOrWhiteSpace(Model.Heading) ? ui.T("confirm.title") : ui.Server(Model.Heading);
    ViewData["Title"] = heading;
    // The page model sets an Arabic heading; a failure heading starts with "تعذر" ("could not").
    var failed = Model.Heading?.StartsWith("تعذر") == true;
}
<h1>@heading</h1>
<partial name="_Message" model="@((failed ? "danger" : "success", ui.Server(Model.Message)))" />
<a class="btn" href="@Model.LoginUrl">@ui.T("confirm.goToLogin")</a>
