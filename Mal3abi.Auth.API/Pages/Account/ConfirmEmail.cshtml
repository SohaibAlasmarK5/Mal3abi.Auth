@page "/account/confirm-email"
@model Mal3abi.Auth.API.Pages.Account.ConfirmEmailModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.T("confirm.title");
}
<h1>@ui.T("confirm.title")</h1>
@if (Model.Done)
{
    <partial name="_Message" model="@(("success", ui.T("confirm.done")))" />
    <a class="btn" href="@Url.Page("/Account/Login", new { returnUrl = Model.ReturnUrl })">@ui.T("confirm.goToLogin")</a>
}
else
{
    <p class="intro">@(Model.HasPending ? ui.T("confirm.intro", Model.MaskedEmail) : ui.T("confirm.introNoEmail"))</p>
    <partial name="_Message" model="@(("success", Model.SuccessMessage ?? ""))" />
    <partial name="_Message" model="@(("danger", Model.ErrorMessage ?? ""))" />
    <div asp-validation-summary="All"></div>
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        @if (!Model.HasPending)
        {
            <div class="field">
                <label asp-for="Email">@ui.T("confirm.email")</label>
                <input asp-for="Email" type="email" autocomplete="email" maxlength="256" />
            </div>
        }
        <partial name="_CodeInput" model="@(new CodeInput(Name: "Code", Label: ui.T("confirm.label"), ResendHandler: "Resend", ResendSeconds: Model.ResendSeconds, State: Model.CodeState))" />
        <button type="submit" class="btn">@ui.T("confirm.submit")</button>
    </form>
    <div class="links">
        <a href="@Url.Page("/Account/Login", new { returnUrl = Model.ReturnUrl })">@ui.T("confirm.goToLogin")</a>
    </div>
}
