@page "/account/forgot-password"
@model Mal3abi.Auth.API.Pages.Account.ForgotPasswordModel
@{ Layout = null; ViewData["Title"] = "استعادة كلمة المرور | ملعبي"; }
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"]</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;padding:18px;background:#0b1220;color:#eef2f8;font:1rem "Segoe UI",Tahoma,Arial}main{width:min(100%,460px);padding:28px;border:1px solid #2b3b55;border-radius:16px;background:#172338}p{color:#aebbd0;line-height:1.7}label{display:block;margin:15px 0 6px}input,button{width:100%;min-height:46px;padding:10px;border-radius:8px;font:inherit}input{border:1px solid #33445e;background:#111b2c;color:white}button{margin-top:18px;border:0;background:#00c875;font-weight:700}a{color:#48adff}</style></head><body><main><h1>استعادة كلمة المرور</h1><p>أدخل بريدك الإلكتروني. إذا كان الحساب مؤكداً، سنرسل رابط إعادة التعيين.</p>@if(Model.Sent){<p role="status">إذا كان هناك حساب مؤكد بهذا البريد، فسيصلك رابط لإعادة التعيين.</p>}else{<form method="post"><label asp-for="Email">البريد الإلكتروني</label><input asp-for="Email" type="email" required autocomplete="email" maxlength="256"><button type="submit">إرسال الرابط</button></form>}<p><a href="/account/login">العودة لتسجيل الدخول</a></p></main></body></html>
