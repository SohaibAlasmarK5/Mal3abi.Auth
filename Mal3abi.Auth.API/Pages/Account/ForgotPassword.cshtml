@page "/account/forgot-password"
@model Mal3abi.Auth.API.Pages.Account.ForgotPasswordModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.T("forgot.title");
}
<h1>@ui.T("forgot.title")</h1>
<p class="intro">@ui.T("forgot.intro")</p>
<partial name="_Message" model="@(("success", Model.SuccessMessage ?? ""))" />
<partial name="_Message" model="@(("danger", Model.ErrorMessage ?? ""))" />
<div asp-validation-summary="All"></div>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label asp-for="Email">@ui.T("forgot.email")</label>
        <input asp-for="Email" type="email" autocomplete="email" required maxlength="256" />
    </div>
    <button type="submit" class="btn">@ui.T("forgot.submit")</button>
</form>
<div class="links">
    <a href="@Url.Page("/Account/Login", new { returnUrl = Model.ReturnUrl })">@ui.T("forgot.back")</a>
</div>
