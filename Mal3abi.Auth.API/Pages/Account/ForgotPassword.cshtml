@page "/account/forgot-password"
@model Mal3abi.Auth.API.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    var ui = AuthUi.For(HttpContext.Request);
    ViewData["Title"] = ui.T("forgot.title");
}
<h1>@ui.T("forgot.title")</h1>
@if (Model.Sent)
{
    <partial name="_Message" model="@(("success", ui.T("forgot.sent")))" />
}
else
{
    <p class="intro">@ui.T("forgot.intro")</p>
    <form method="post">
        <div class="field">
            <label asp-for="Email">@ui.T("forgot.email")</label>
            <input asp-for="Email" type="email" required autocomplete="email" maxlength="256" />
        </div>
        <button type="submit" class="btn">@ui.T("forgot.submit")</button>
    </form>
}
<div class="links">
    <a href="/account/login">@ui.T("forgot.back")</a>
</div>
