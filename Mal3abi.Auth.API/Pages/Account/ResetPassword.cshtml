@page "/account/reset-password"
@model Mal3abi.Auth.API.Pages.Account.ResetPasswordModel
@{
    Layout = "_AuthLayout";
    var ui = AuthUi.For(HttpContext.Request);
    ViewData["Title"] = ui.T("reset.title");
}
<h1>@ui.T("reset.title")</h1>
<partial name="_Message" model="@((Model.Succeeded ? "success" : "danger", ui.Server(Model.Message)))" />
@if (Model.Succeeded)
{
    <a class="btn" href="/account/login">@ui.T("reset.signIn")</a>
}
else
{
    <form method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <div class="field">
            <label asp-for="Password">@ui.T("reset.password")</label>
            <input asp-for="Password" type="password" minlength="8" maxlength="128" required autocomplete="new-password" />
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">@ui.T("reset.confirm")</label>
            <input asp-for="ConfirmPassword" type="password" minlength="8" maxlength="128" required autocomplete="new-password" />
        </div>
        <button type="submit" class="btn">@ui.T("reset.submit")</button>
    </form>
}
