@page "/account/reset-password"
@model Mal3abi.Auth.API.Pages.Account.ResetPasswordModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.T("reset.title");
}
<h1>@ui.T("reset.title")</h1>
@if (Model.Done)
{
    <partial name="_Message" model="@(("success", ui.T("reset.done")))" />
    <a class="btn" href="@Url.Page("/Account/Login")">@ui.T("reset.signIn")</a>
}
else
{
    <partial name="_Message" model="@(("danger", Model.ErrorMessage ?? ""))" />
    <div asp-validation-summary="All"></div>
    <form method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <div class="field">
            <label asp-for="Password">@ui.T("reset.password")</label>
            <input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required aria-describedby="password-hint" />
            <p class="hint" id="password-hint">@ui.T("register.passwordHint")</p>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">@ui.T("reset.confirm")</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required />
        </div>
        <button type="submit" class="btn">@ui.T("reset.submit")</button>
    </form>
}
