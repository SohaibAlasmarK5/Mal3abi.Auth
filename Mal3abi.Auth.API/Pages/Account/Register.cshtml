@page "/account/register"
@model Mal3abi.Auth.API.Pages.Account.RegisterModel
@{
    var ui = Model.Ui;
    var owner = Model.IsOwner;
    ViewData["Title"] = ui.T(owner ? "register.ownerTitle" : "register.title");
}
<h1>@ui.T(owner ? "register.ownerTitle" : "register.title")</h1>
<p class="intro">@ui.T(owner ? "register.ownerIntro" : "register.intro")</p>
<partial name="_Message" model="@(("danger", Model.ErrorMessage ?? ""))" />
<div asp-validation-summary="All"></div>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="As" />
    <div class="field">
        <label asp-for="Input.Name">@ui.T("register.name")</label>
        <input asp-for="Input.Name" autocomplete="name" required maxlength="120" dir="auto" />
    </div>
    <div class="field">
        <label asp-for="Input.Username">@ui.T("register.username")</label>
        <input asp-for="Input.Username" autocomplete="username" required minlength="3" maxlength="32" class="ltr" aria-describedby="username-hint" />
        <p class="hint" id="username-hint">@ui.T("register.usernameHint")</p>
    </div>
    <div class="field">
        <label asp-for="Input.Email">@ui.T("register.email")</label>
        <input asp-for="Input.Email" type="email" autocomplete="email" required maxlength="256" />
    </div>
    <div class="field">
        <label asp-for="Input.Phone">@ui.T("register.phone")</label>
        <input asp-for="Input.Phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="32" />
    </div>
    <div class="field">
        <label asp-for="Input.Age">@ui.T("register.age")</label>
        <input asp-for="Input.Age" type="number" inputmode="numeric" min="13" max="120" required />
    </div>
    <div class="field">
        <label asp-for="Input.PhotoUrl">@ui.T("register.photo")</label>
        <input asp-for="Input.PhotoUrl" type="url" maxlength="2048" />
    </div>
    <div class="field">
        <label asp-for="Input.Password">@ui.T("register.password")</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required aria-describedby="password-hint" />
        <p class="hint" id="password-hint">@ui.T("register.passwordHint")</p>
    </div>
    <button type="submit" class="btn">@ui.T("register.submit")</button>
</form>
<div class="links">
    <span>@ui.T("register.haveAccount")</span>
    <a href="@Url.Page("/Account/Login", new { returnUrl = Model.ReturnUrl })">@ui.T("register.signIn")</a>
</div>
<div class="divider"></div>
<div class="links">
    @if (owner)
    {
        <span>@ui.T("register.playerQuestion")</span>
        <a href="@Url.Page("/Account/Register", new { returnUrl = Model.ReturnUrl })">@ui.T("register.playerLink")</a>
    }
    else
    {
        <span>@ui.T("register.ownerQuestion")</span>
        <a href="@Url.Page("/Account/Register", new { returnUrl = Model.ReturnUrl, @as = "owner" })">@ui.T("register.ownerLink")</a>
    }
</div>
