@page "/account/security"
@model Mal3abi.Auth.API.Pages.Account.SecurityModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.T("security.title");
}
<h1>@ui.T("security.title")</h1>
<partial name="_Message" model="@(("success", Model.SuccessMessage ?? ""))" />
<partial name="_Message" model="@(("danger", Model.ErrorMessage ?? ""))" />
@switch (Model.Kind)
{
    case "admin" when Model.AuthenticatorOn:
        <partial name="_Message" model="@(("success", ui.T("security.adminOn")))" />
        break;
    case "admin":
        <p class="intro">@ui.T("security.adminIntro")</p>
        <p>@ui.T("security.addKey")</p>
        <div class="field">
            <span class="hint">@ui.T("security.keyLabel")</span>
            <code class="key">@Model.Setup?.SharedKey</code>
        </div>
        <div class="field">
            <span class="hint">@ui.T("security.uriLabel")</span>
            <code class="key">@Model.Setup?.AuthenticatorUri</code>
        </div>
        <form method="post" asp-page-handler="Authenticator">
            <input type="hidden" asp-for="ReturnUrl" />
            <partial name="_CodeInput" model="@(new CodeInput(Name: "Code", Label: ui.T("security.codeLabel"), State: Model.CodeState))" />
            <button type="submit" class="btn">@ui.T("security.submit")</button>
        </form>
        break;
    case "owner":
        <partial name="_Message" model="@(("success", ui.T("security.ownerOn")))" />
        break;
    default:
        <p class="intro">@ui.T(Model.EmailOn ? "security.playerOn" : "security.playerOff")</p>
        <form method="post" asp-page-handler="Email">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" name="enabled" value="@(Model.EmailOn ? "false" : "true")" />
            <button type="submit" class="btn @(Model.EmailOn ? "btn-secondary" : "")">@ui.T(Model.EmailOn ? "security.turnOff" : "security.turnOn")</button>
        </form>
        break;
}
@if (!string.IsNullOrEmpty(Model.ContinueUrl))
{
    <a class="btn" href="@Model.ContinueUrl">@ui.T("security.continue")</a>
}
<div class="divider"></div>
<div class="links">
    <a href="@Url.Page("/Account/Logout")">@ui.T("security.signOut")</a>
</div>
