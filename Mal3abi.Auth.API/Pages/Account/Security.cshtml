@page "/account/security"
@model Mal3abi.Auth.API.Pages.Account.SecurityModel
@{
    Layout = "_AuthLayout";
    var ui = AuthUi.For(HttpContext.Request);
    ViewData["Title"] = ui.T("security.title");
}
<h1>@ui.T("security.title")</h1>
<p class="intro">@ui.T("security.intro")</p>
@if (Model.IsEnabled)
{
    <partial name="_Message" model="@(("success", ui.T("security.enabled")))" />
}
else
{
    <p>@ui.T("security.addKey")</p>
    <div class="field">
        <span class="hint">@ui.T("security.keyLabel")</span>
        <code class="key">@Model.SharedKey</code>
    </div>
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <partial name="_CodeInput" model="@(new CodeInput(Name: "Code", Label: ui.T("security.codeLabel")))" />
        <button type="submit" class="btn">@ui.T("security.submit")</button>
    </form>
}
<partial name="_Message" model="@((Model.Success ? "success" : "danger", ui.Server(Model.Message)))" />
