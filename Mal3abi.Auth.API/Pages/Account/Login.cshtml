@page "/account/login"
@model Mal3abi.Auth.API.Pages.Account.LoginModel
@{
    var ui = Model.Ui;
    ViewData["Title"] = ui.T("login.title");
}
<h1>@ui.T("login.title")</h1>
<p class="intro">@ui.T("login.intro")</p>
<partial name="_Message" model="@(("success", Model.SuccessMessage ?? ""))" />
<partial name="_Message" model="@(("danger", Model.ErrorMessage ?? ""))" />
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label asp-for="Input.Identifier">@ui.T("login.identifier")</label>
        <input asp-for="Input.Identifier" autocomplete="username" required maxlength="256" autofocus dir="auto" />
    </div>
    <div class="field">
        <label asp-for="Input.Password">@ui.T("login.password")</label>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" required maxlength="128" />
    </div>
    <label class="check"><input asp-for="Input.RememberMe" /> @ui.T("login.remember")</label>
    <button type="submit" class="btn">@ui.T("login.submit")</button>
</form>
<div class="links">
    <a href="@Url.Page("/Account/ForgotPassword", new { returnUrl = Model.ReturnUrl })">@ui.T("login.forgot")</a>
</div>
<div class="divider"></div>
<div class="links">
    <span>@ui.T("login.noAccount")</span>
    <a href="@Url.Page("/Account/Register", new { returnUrl = Model.ReturnUrl })">@ui.T("login.createPlayer")</a>
</div>
<div class="links">
    <span>@ui.T("login.ownerQuestion")</span>
    <a href="@Url.Page("/Account/Register", new { returnUrl = Model.ReturnUrl, @as = "owner" })">@ui.T("login.createOwner")</a>
</div>
