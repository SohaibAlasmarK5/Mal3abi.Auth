@page "/account/login"
@model Mal3abi.Auth.API.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    var ui = AuthUi.For(HttpContext.Request);
    ViewData["Title"] = ui.T(Model.RequireTwoFactor ? "login.twoFactorTitle" : "login.title");
}
@if (Model.RequireTwoFactor)
{
    <h1>@ui.T("login.twoFactorTitle")</h1>
    <p class="intro">@ui.T("login.twoFactorIntro")</p>
}
else
{
    <h1>@ui.T("login.title")</h1>
    <p class="intro">@ui.T("login.intro")</p>
}
<partial name="_Message" model="@(("danger", ui.Server(Model.ErrorMessage)))" />
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    @if (Model.RequireTwoFactor)
    {
        <input type="hidden" asp-for="Input.Identifier" />
        <partial name="_CodeInput" model="@(new CodeInput(Name: "Input.AuthenticatorCode", Label: ui.T("login.twoFactorLabel")))" />
        <label class="check"><input asp-for="Input.RememberMe" /> @ui.T("login.remember")</label>
        <button type="submit" class="btn">@ui.T("login.verify")</button>
    }
    else
    {
        <div class="field">
            <label asp-for="Input.Identifier">@ui.T("login.identifier")</label>
            <input asp-for="Input.Identifier" autocomplete="username" required maxlength="256" autofocus dir="auto" />
        </div>
        <div class="field">
            <label asp-for="Input.Password">@ui.T("login.password")</label>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
        </div>
        <label class="check"><input asp-for="Input.RememberMe" /> @ui.T("login.remember")</label>
        <button type="submit" class="btn">@ui.T("login.submit")</button>
    }
</form>
@if (!Model.RequireTwoFactor)
{
    <div class="links">
        <a href="/account/forgot-password">@ui.T("login.forgot")</a>
    </div>
    <div class="divider"></div>
    <div class="links">
        <span>@ui.T("login.noAccount")</span>
        <a href="@Url.Page("/Account/Register", new { returnUrl = Model.ReturnUrl })">@ui.T("login.createPlayer")</a>
    </div>
}
